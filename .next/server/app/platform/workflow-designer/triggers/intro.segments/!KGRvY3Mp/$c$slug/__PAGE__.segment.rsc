0:{"rsc":["$","$1","c",{"children":[["$","$L2",null,{"children":[["$","$L3",null,{"children":"Triggers"}],["$","$L4",null,{}],["$","$L5",null,{"children":[["$","$L6",null,{"as":"h1","id":"triggers","children":"Triggers"}],"\n",["$","p",null,{"children":"Triggers are built-in tools designed to initiate workflows in APPSe AI. They act as the entry point for workflow execution by capturing events or conditions defined by the user. Once a trigger node is activated, it starts the workflow and passes the relevant data to the connected downstream nodes for further processing."}],"\n",["$","p",null,{"children":"Triggers always appear at the beginning of a workflow and cannot have any incoming connections."}],"\n",["$","p",null,{"children":[["$","strong",null,{"children":["$","code",null,{"children":"Note:"}]}]," Triggers do not include App triggers, these are built-in tools from APPSe AI."]}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":"A workflow must have at least one trigger node to be executable."}],"\n",["$","li",null,{"children":"Some triggers may require credentials to authenticate with external applications (e.g., when listening for events from a third-party system). Others, such as manual triggers, may not need any credentials."}],"\n"]}],"\n",["$","p",null,{"children":"Check out the upcoming pages to know more about individual triggers."}],"\n",["$","hr",null,{}]]}]]}],[["$","script","script-0",{"src":"/_next/static/chunks/07gf9426_qd6v.js","async":true}],["$","script","script-1",{"src":"/_next/static/chunks/0j~v0urs.4t0i.js","async":true}]],["$","$L7",null,{"children":["$","$8",null,{"name":"Next.MetadataOutlet","children":"$@9"}]}]]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"dhKpBvI8-ru6M9TR_EdEN"}
