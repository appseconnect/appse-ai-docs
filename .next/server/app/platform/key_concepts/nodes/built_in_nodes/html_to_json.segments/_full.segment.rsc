f:["$","$L18",null,{"toc":"$undefined","full":"$undefined","children":[["$","$L19",null,{"children":"HTML to JSON Node"}],["$","$L1a",null,{"children":"$undefined"}],["$","$L1b",null,{"children":[["$","p",null,{"children":["The HTML to JSON node in Appse AI is a built-in node that helps extract structured data from raw HTML content using CSS selectors.",["$","br",null,{}],"\n","It converts unstructured or semi-structured HTML into clean JSON output, making it easier for downstream nodes to process and map the data."]}],"\n",["$","p",null,{"children":"This node is commonly used when working with:"}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":"Web page HTML responses"}],"\n",["$","li",null,{"children":"HTML email bodies"}],"\n"]}],"\n",["$","hr",null,{}],"\n",["$","$L1c",null,{"as":"h2","id":"configuration-options","children":"Configuration Options"}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":["\n",["$","p",null,{"children":[["$","strong",null,{"children":"Source"}]," – Specifies the field that contains the raw HTML string."]}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":"If you are entering the value manually as text, specify the property that exists inside the JSON object that contains HTML value returned by the previous node (for example: html_content)."}],"\n",["$","li",null,{"children":"If you are using drag and drop, simply drag the property that exists inside the JSON object that contains HTML value from the previous node's output. It will automatically be added as an expression."}],"\n"]}],"\n"]}],"\n",["$","li",null,{"children":["\n",["$","p",null,{"children":["$","strong",null,{"children":"Extraction Rules"}]}],"\n",["$","p",null,{"children":[["$","strong",null,{"children":"Item #1"}]," – Extraction rule for a single output field"]}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Key"}]," – Defines the output JSON key where the extracted value will be stored."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"CSS Selector"}]," – A CSS selector used to find elements within the HTML."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Return Type"}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Text"}]," – Extracts visible text content."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"HTML"}]," – Extracts inner HTML of the selected element."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Attribute"}]," – Extracts a specific attribute value (e.g., ",["$","code",null,{"children":"href"}],", ",["$","code",null,{"children":"src"}],", ",["$","code",null,{"children":"class"}],", ",["$","code",null,{"children":"value"}],").","\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Attribute Name"}]," – The name of the attribute to extract."]}],"\n"]}],"\n"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Value"}]," – Extracts the value of form elements (",["$","code",null,{"children":"input"}],", ",["$","code",null,{"children":"textarea"}],", ",["$","code",null,{"children":"select"}],")."]}],"\n"]}],"\n"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Optionals"}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Return Array"}]," – Returns multiple extracted values as an array."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Skip Selectors"}]," (available only for Text return type) – Ignores specified child elements during text extraction."]}],"\n"]}],"\n"]}],"\n"]}],"\n"]}],"\n",["$","li",null,{"children":["\n",["$","p",null,{"children":["$","strong",null,{"children":"Optionals"}]}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Trim Values"}]," – Removes leading and trailing whitespace."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Clean Up Text"}]," – Normalizes text by removing extra spaces, line breaks, and HTML entities."]}],"\n"]}],"\n"]}],"\n"]}],"\n",["$","hr",null,{}],"\n",["$","$L1c",null,{"as":"h2","id":"steps-to-use-html-to-json-node","children":"Steps to Use HTML to JSON Node"}],"\n",["$","$L1c",null,{"as":"h3","id":"1-select-html-to-json-node","children":"1. Select HTML to JSON Node"}],"\n",["$","p",null,{"children":["Select ",["$","strong",null,{"children":"HTML to JSON"}]," from the node selection screen.\r",["$","$L1d",null,{"sizes":"(max-width: 768px) 100vw, (max-width: 1200px) 70vw, 900px","alt":"","src":{"src":"/_next/static/media/select_html_to_json.00-go_tmms54q.png","width":1919,"height":990,"blurWidth":8,"blurHeight":4,"blurDataURL":"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAgAAAAECAYAAACzzX7wAAAAdUlEQVR42j3KQQ6CMAAAQf7/ASKREI0xSvRFGkrUSrGFVqnQnla5cJjsZZN0vacSd7Tp6Xq3aJQm35Qk+fbE4Ee+U8TPxsjHB5R+kxVHkmJ3JoSI9RPGDljn/u1otWU1D1lR0r4MtVRchKS6NYjHk2stSfMDP2MqcZGfSgF2AAAAAElFTkSuQmCC"},"className":"rounded-lg"}]]}],"\n","$L1e","\n","$L1f","\n","$L20","\n","$L21","\n","$L22","\n","$L23","\n","$L24","\n","$L25","\n","$L26","\n","\n","\n","$L27","\n","$L28","\n","$L29","\n","$L2a","\n","$L2b","\n","$L2c","\n","$L2d","\n","$L2e","\n","$L2f","\n","$L30","\n","$L31","\n","$L32","\n","$L33","\n","$L34","\n","$L35","\n","$L36","\n","$L37","\n","$L38","\n","$L39","\n","\n","\n","$L3a","\n","$L3b","\n","$L3c","\n","$L3d","\n","$L3e","\n","$L3f","\n","$L40","\n","$L41","\n","$L42","\n","$L43","\n","$L44","\n","$L45","\n","$L46","\n","$L47","\n","$L48","\n","$L49","\n","$L4a","\n","$L4b","\n","\n","\n","$L4c","\n","$L4d","\n","$L4e","\n","$L4f","\n","$L50","\n","$L51","\n","$L52","\n","$L53","\n","$L54","\n","$L55","\n","$L56","\n","$L57","\n","$L58","\n","$L59","\n","$L5a","\n","$L5b","\n","$L5c","\n","$L5d","\n","$L5e","\n","\n","\n","$L5f","\n","$L60","\n","$L61","\n","$L62","\n","$L63","\n","$L64","\n","$L65","\