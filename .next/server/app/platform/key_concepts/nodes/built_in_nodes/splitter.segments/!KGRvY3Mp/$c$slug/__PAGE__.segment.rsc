0:{"rsc":["$","$1","c",{"children":[["$","$L2",null,{"children":[["$","$L3",null,{"children":"Splitter Node"}],["$","$L4",null,{}],["$","$L5",null,{"children":[["$","p",null,{"children":"The Splitter node in Appse AI is a built-in action node that helps you divide array-type data into individual items. It allows each item in a list, such as order lines, products, or records, to be processed separately in the workflow."}],"\n",["$","p",null,{"children":"This is useful when you receive multiple records from an app or API and want to handle each record independently through subsequent nodes."}],"\n",["$","$L6",null,{"as":"h2","id":"how-it-works","children":"How It Works"}],"\n",["$","p",null,{"children":"When data passes through the Splitter node, it identifies the array field and splits each item from that array into separate outputs. Each split item is then processed individually in the next connected nodes."}],"\n",["$","$L6",null,{"as":"h2","id":"configuration","children":"Configuration"}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Fields to Split"}]," - Enter the array field name that contains multiple records you want to split."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Include"}]," - Decide whether you want to include additional fields from the parent object along with each split item.","\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"No other fields"}],": Only the items from the selected field will be passed to the next node."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"All other fields"}],": The split items will also include all other fields from the parent data."]}],"\n"]}],"\n"]}],"\n"]}],"\n",["$","$L6",null,{"as":"h2","id":"steps-to-use-the-splitter-node","children":"Steps to Use the Splitter Node"}],"\n",["$","ol",null,{"children":["\n",["$","li",null,{"children":["\n",["$","p",null,{"children":[["$","st