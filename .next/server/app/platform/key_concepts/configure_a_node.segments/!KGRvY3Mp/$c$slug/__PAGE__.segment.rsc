0:{"rsc":["$","$1","c",{"children":[["$","$L2",null,{"children":[["$","$L3",null,{"children":"Execution History"}],["$","$L4",null,{"children":"Keep track of all the executions performed by your workflows, check status, data transferred and much more."}],["$","$L5",null,{"children":[["$","$L6",null,{"as":"h1","id":"execution-history","children":"Execution History"}],"\n",["$","p",null,{"children":["The ",["$","strong",null,{"children":"Workflow Execution History"}]," helps users monitor and review past workflow runs. It provides detailed logs and a visual preview of each execution, allowing users to analyze, debug, and understand how their workflows performed at every step.",["$","br",null,{}],"\n","This feature offers clear visibility into data flow, execution results, and overall workflow performance."]}],"\n",["$","hr",null,{}],"\n",["$","$L6",null,{"as":"h2","id":"how-to-view-execution-history","children":"How to View Execution History"}],"\n",["$","p",null,{"children":"To view the Execution History:"}],"\n",["$","ol",null,{"children":["\n",["$","li",null,{"children":["Navigate to the ",["$","strong",null,{"children":"Workflows"}]," section on ",["$","$L7",null,{"href":"https://workflow.appse.ai/","children":"appse ai"}],"."]}],"\n",["$","li",null,{"children":["In the workflow list, click the ",["$","strong",null,{"children":"View Execution History"}]," button next to the desired workflow."]}],"\n"]}],"\n","\n",["$","hr",null,{}],"\n",["$","$L6",null,{"as":"h2","id":"read-only-preview-mode","children":"Read-only Preview Mode"}],"\n",["$","p",null,{"children":["In the ",["$","strong",null,{"children":"Read-only Preview"}]," mode, you’ll see the familiar workflow canvas displayed in a strictly read-only state, showing the exact workflow structure as it existed during that specific execution."]}],"\n","\n",["$","p",null,{"children":["The ",["$","strong",null,{"children":"Individual Run Preview"}]," opens when a user clicks on a node within the workflow preview window.",["$","br",null,{}],"\n","It displays the input and output payloads for each executed node — whether successful or failed — in a read-only format similar to the node configuration window.",["$","br",null,{}],"\n","This allows users to review the data processed by each node and identify any errors that occurred during execution."]}],"\n","\n",["$","hr",null,{}],"\n",["$","$L6",null,{"as":"h2","id":"list-of-executions","children":"List of Executions"}],"\n",["$","p",null,{"children":["The ",["$","strong",null,{"children":"Workflow Execution Records"}]," section within the Execution History provides a comprehensive, sortable, and filterable list of all past workflow runs.",["$","br",null,{}],"\n","It displays key execution details such as time, status, and performance metrics in a clear, structured format, helping users quickly locate specific runs and monitor workflow performance more effectively."]}],"\n","\n",["$","hr",null,{}],"\n",["$","$L6",null,{"as":"h2","id":"filter-by","children":"Filter By"}],"\n",["$","p",null,{"children":["The ",["$","strong",null,{"children":"Filter By"}]," option opens a panel that lets users refine the list of workflow executions by status (e.g., Success or Error) and date range.",["$","br",null,{}],"\n","After selecting the desired filters, click ",["$","strong",null,{"children":"Apply Filters"}]," to update the list or ",["$","strong",null,{"children":"Clear Filters"}]," to reset all selections."]}],"\n","\n",["$","hr",null,{}],"\n",["$","$L6",null,{"as":"h2","id":"execution-card","children":"Execution Card"}],"\n",["$","p",null,{"children":["Each ",["$","strong",null,{"children":"Execution Card"}]," represents a single workflow run and displays details such as status, timestamp, Execution ID, and execution time.",["$","br",null,{}],"\n","Selecting a card loads a read-only preview of that specific workflow execution."]}],"\n",["$","hr",null,{}],"\n",["$","$L6",null,{"as":"h2","id":"card-navigator","children":"Card Navigator"}],"\n",["$","p",null,{"children":["The ",["$","strong",null,{"children":"Card Navigator"}]," enables users to move between different execution cards.",["$","br",null,{}],"\n","Click the arrow buttons to browse through records — the workflow preview updates automatically to display the corresponding workflow execution for the selected card."]}],"\n","$L8"]}]]}],["$L9","$La"],"$Lb"]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"XlvOiWoJVL0dYdUh2uKdR"}
