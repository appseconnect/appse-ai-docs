175:["$","$L178",null,{"children":[["$","p",null,{"children":"SAP Business One (SAP B1) is an integrated enterprise resource planning (ERP) solution designed for small and medium-sized businesses. With appse ai, you can seamlessly connect SAP B1 to your workflows, automating processes like inventory management, financial reporting, and customer relationship management to improve business performance and agility."}],"\n",["$","hr",null,{}],"\n",["$","$L179",null,{"as":"h2","id":"setup-credential","children":"Setup Credential"}],"\n",["$","p",null,{"children":"Follow the steps below to quickly set up your credential."}],"\n",["$","$L179",null,{"as":"h3","id":"configuration-fields","children":"Configuration Fields"}],"\n",["$","p",null,{"children":"You will be asked to fill in the following details:"}],"\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n",["$","div",null,{"className":"relative overflow-auto prose-no-margin my-6","children":["$","table",null,{"children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"children":"Field"}],["$","th",null,{"children":"Description"}]]}]}],["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","td",null,{"children":"Host URL"}],["$","td",null,{"children":"The server URL where your SAP B1 is hosted"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"Port"}],["$","td",null,{"children":"The port number for the SAP B1 service layer"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"Username"}],["$","td",null,{"children":"Your SAP B1 username"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"Password"}],["$","td",null,{"children":"Your SAP B1 password"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"Company DB"}],["$","td",null,{"children":"The company database name used in SAP B1"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"Additional Path"}],["$","td",null,{"children":"Provide Additional Path (Optional)"}]]}]]}]]}