1f:["$","ul",null,{"children":["\n",["$","li",null,{"children":["\n",["$","p",null,{"children":[["$","strong",null,{"children":"On Company Created"}]," — Fires whenever a new company is created in your Teamwork site. Use this to automatically kick off workflows when a new client or organization is added."]}],"\n"]}],"\n",["$","li",null,{"children":["\n",["$","p",null,{"children":[["$","strong",null,{"children":"On Person Created"}]," — Fires whenever a new person or contact is created in your Teamwork site. Use this to trigger onboarding workflows or sync contact data with other systems."]}],"\n"]}],"\n",["$","li",null,{"children":["\n",["$","p",null,{"children":[["$","strong",null,{"children":"On Project Created"}]," — Fires whenever a new project is created in your Teamwork site. Use this to automatically set up tasks, notify team members, or sync project data across platforms."]}],"\n"]}],"\n",["$","li",null,{"children":["\n",["$","p",null,{"children":[["$","strong",null,{"children":"On Task Created"}]," — Fires whenever a new task is created in your Teamwork site. Use this to trigger notifications, assign resources, or update external systems in real time."]}],"\n"]}],"\n"]}]
