15:["$","ul",null,{"children":["\n",["$","li",null,{"children":["\n",["$","p",null,{"children":[["$","strong",null,{"children":"Chat Completions"}]," — Send a prompt to an AI language model and receive a generated text response. Useful for building conversational agents, answering questions, or generating content through any of Eden AI's supported LLM providers."]}],"\n"]}],"\n",["$","li",null,{"children":["\n",["$","p",null,{"children":[["$","strong",null,{"children":"Analyze Sentiment"}]," — Analyze the sentiment of a given text and determine whether it is positive, negative, or neutral. Ideal for monitoring feedback, reviews, or social media content."]}],"\n"]}],"\n",["$","li",null,{"children":["\n",["$","p",null,{"children":[["$","strong",null,{"children":"Named Entity Recognition"}]," — Identify and extract named entities from text such as people, organizations, locations, dates, and more. Useful for structuring unstructured text data."]}],"\n"]}],"\n",["$","li",null,{"children":["\n",["$","p",null,{"children":[["$","strong",null,{"children":"Text Moderation"}]," — Automatically detect and flag harmful, offensive, or inappropriate content within a given text. Useful for content filtering in user-generated platforms."]}],"\n"]}],"\n",["$","li",null,{"children":["\n",["$","p",null,{"children":[["$","strong",null,{"children":"Topic Extraction"}]," — Extract the key topics and themes from a body of text. Helps categorize and understand large volumes of content at a glance."]}],"\n"]}],"\n",["$","li",null,{"children":["\n",["$","p",null,{"children":[["$","strong",null,{"children":"Translate Text"}]," — Translate text from one language to another using Eden AI's supported translation providers. Supports a wide range of languages for global workflows."]}],"\n"]}],"\n"]}]
