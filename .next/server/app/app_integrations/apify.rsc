fy Scraper"}],", ",["$","code",null,{"children":"Product Monitor Feed"}],")."]}],"\n",["$","li",null,{"children":"This helps you easily recognize the connection within our platform."}],"\n"]}],"\n",["$","$L1c",null,{"as":"h4","id":"2-find-your-bearer-token","children":"2. Find Your Bearer Token"}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":["Log in to your ",["$","strong",null,{"children":"Apify"}]," account at ","$L1d","."]}],"\n",["$","li",null,{"children":["Go to the ",["$","strong",null,{"children":"Settings"}]," page from the sidebar."]}],"\n"]}],"\n",["$","p",null,{"children":["$","$L1e",null,{"sizes":"(max-width: 768px) 100vw, (max-width: 1200px) 70vw, 900px","alt":"Apify Credentials Settings","src":{"src":"/_next/static/media/apify-cred-settings.0junyamn~6bc2.png","width":1920,"height":1032,"blurWidth":8,"blurHeight":4,"blurDataURL":"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAgAAAAECAYAAACzzX7wAAAAWUlEQVR42h2MSQqAMBTFev+T6ko7/LGUWLt4hAchRcRYa51lTvoQcs7z52YxcyICsUDNUDXc48hHUE/u5lyPoCLYlkSUWjuRSakaPOK0PtCh9J+78r6NOpwPMuV8aL+W2OcAAAAASUVORK5CYII="},"className":"rounded-lg"}]}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":["Click on the ",["$","strong",null,{"children":"Integrations"}]," tab. Next, under ",["$","strong",null,{"children":"API"}],", copy the ",["$","strong",null,{"children":"Personal API Token"}],"."]}],"\n"]}],"\n",["$","p",null,{"children":["$","$L1e",null,{"sizes":"(max-width: 768px) 100vw, (max-width: 1200px) 70vw, 900px","alt":"Apify Credentials Bearer Token","src":{"src":"/_next/static/media/apify-cred-bearer-token.12aph3w1td5qx.png","width":1920,"height":1032,"blurWidth":8,"blurHeight":4,"blurDataURL":"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAgAAAAECAYAAACzzX7wAAAAW0lEQVR42h2MSQ7DMAwD/f+f9lCgcKPIspaJ4gNBgEPMEFF+U/j8N19x1JysooC9naG6mJcyxVg7WZ5Y1Om72TDbyK1cbYqsk9eQ3S87BncnIntsw7IDq0+yggc8l31l6iQpaAAAAABJRU5ErkJggg=="},"className":"rounded-lg"}]}],"\n",["$","blockquote",null,{"children":["\