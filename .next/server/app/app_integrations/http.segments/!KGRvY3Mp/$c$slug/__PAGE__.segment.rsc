2b:["$","p",null,{"children":["After completing the configuration and clicking ",["$","strong",null,{"children":"Run"}],", the HTTP app will send a POST request to the specified API endpoint with the provided data. Upon success, the response, including details like status and returned data (e.g., created or updated contact info), will be displayed in the Output section, ready for use in the next steps of your workflow.\n","\n","\n",["$","$L7",null,{"sizes":"(max-width: 768px) 100vw, (max-width: 1200px) 70vw, 900px","alt":"o auth patch method","src":{"src":"/_next/static/media/o-auth-patch-method.0ahxe_zwv.-6..png","width":1198,"height":144,"blurWidth":8,"blurHeight":1,"blurDataURL":"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAgAAAABCAYAAADjAO9DAAAAG0lEQVR42mP49Onz/9+///z/+/cfBv7z5+9/AAbVH48e+2laAAAAAElFTkSuQmCC"},"className":"rounded-lg"}]]}]
