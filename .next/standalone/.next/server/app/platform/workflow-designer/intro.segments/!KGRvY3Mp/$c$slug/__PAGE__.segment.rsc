riven steps into one cohesive workflow."}],"\n"]}]]}]]}],[["$","script","script-0",{"src":"/_next/static/chunks/07gf9426_qd6v.js","async":true}],["$","script","script-1",{"src":"/_next/static/chunks/0j~v0urs.4t0i.js","async":true}]],["$","$L7",null,{"children":["$","$8",null,{"name":"Next.MetadataOutlet","children":"$@9"}]}]]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"dhKpBvI8-ru6M9TR_EdEN"}
