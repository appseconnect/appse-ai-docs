0:{"rsc":["$","$1","c",{"children":[["$","$L2",null,{"toc":[{"depth":1,"url":"#execution-history","title":"Execution History"},{"depth":2,"url":"#how-to-view-execution-history","title":"How to View Execution History"},{"depth":2,"url":"#read-only-preview-mode","title":"Read-only Preview Mode"},{"depth":2,"url":"#list-of-executions","title":"List of Executions"},{"depth":2,"url":"#filter-by","title":"Filter By"},{"depth":2,"url":"#execution-card","title":"Execution Card"},{"depth":2,"url":"#card-navigator","title":"Card Navigator"}],"children":[["$","$L3",null,{"children":"Execution History"}],["$","$L4",null,{"children":"Keep track of all the executions performed by your workflows, check status, data transferred and much more."}],["$","$L5",null,{"children":[["$","$L6",null,{"as":"h1","id":"execution-history","children":"Execution History"}],"\n",["$","p",null,{"children":["The ",["$","strong",null,{"children":"Workflow Execution History"}]," helps users monitor and review past workflow runs. It provides detailed logs and a visual preview of each execution, allowing users to analyze, debug, and understand how their workflows performed at every step.",["$","br",null,{}],"\nThis feature offers clear visibility into data flow, execution results, and overall workflow performance."]}],"\n",["$","hr",null,{}],"\n",["$","$L6",null,{"as":"h2","id":"how-to-view-execution-history","children":"How to View Execution History"}],"\n",["$","p",null,{"children":"To view the Execution History:"}],"\n",["$","ol",null,{"children":["\n",["$","li",null,{"children":["Navigate to the ",["$","strong",null,{"children":"Workflows"}]," section on ",["$","$L7",null,{"href":"https://workflow.appse.ai/","children":"appse ai"}],"."]}],"\n",["$","li",null,{"children":["In the workflow list, click the ",["$","strong",null,{"children":"View Execution History"}]," button next to the desired workflow."]}],"\n"]}],"\n",["$","br",null,{}],"\n![workflow listing screen](/img/platform/key-concepts/execution-history/workflow-listing.png)\n",["$","br",null,{}],["$","br",null,{}],"\n![execution history screen](/img/platform/key-concepts/execution-history/execution-history.png)\n",["$","hr",null,{}],"\n",["$","$L6",null,{"as":"h2","id":"read-only-preview-mode","children":"Read-only Preview Mode"}],"\n",["$","p",null,{"children":["In the ",["$","strong",null,{"children":"Read-only Preview"}]," mode, you’ll see the familiar workflow canvas displayed in a strictly read-only state, showing the exact workflow structure as it existed during that specific execution."]}],"\n",["$","br",null,{}],"\n![node payload preview](/img/platform/key-concepts/execution-history/node-payload-preview.png)\n",["$","p",null,{"children":["The ",["$","strong",null,{"children":"Individual Run Preview"}]," opens when a user clicks on a node within the workflow preview window.",["$","br",null,{}],"\nIt displays the input and output payloads for each executed node — whether successful or failed — in a read-only format similar to the node configuration window.",["$","br",null,{}],"\nThis allows users to review the data processed by each node and identify any errors that occurred during execution."]}],"\n",["$","br",null,{}],"\n![output input node preview](/img/platform/key-concepts/execution-history/output-input-node-preview.png)\n",["$","hr",null,{}],"\n",["$","$L6",null,{"as":"h2","id":"list-of-executions","children":"List of Executions"}],"\n",["$","p",null,{"children":["The ",["$","strong",null,{"children":"Workflow Execution Records"}]," section within the Execution History provides a comprehensive, sortable, and filterable list of all past workflow runs.",["$","br",null,{}],"\nIt displays key execution details such as time, status, and performance metrics in a clear, structured format, helping users quickly locate specific runs and monitor workflow performance more effectively."]}],"\n",["$","br",null,{}],"\n![execution records listing](/img/platform/key-concepts/execution-history/execution-recor