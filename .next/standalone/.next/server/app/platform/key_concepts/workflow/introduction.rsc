4a:["$","p",null,{"children":["$","$L1e",null,{"sizes":"(max-width: 768px) 100vw, (max-width: 1200px) 70vw, 900px","alt":"redo button","src":{"src":"/_next/static/media/redo.0jo8sf6sx0bux.png","width":306,"height":386,"blurWidth":6,"blurHeight":8,"blurDataURL":"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAYAAAAICAYAAADaxo44AAAAlUlEQVR42k2OuwrCQBRE89tWFlYWgp3gl2ijpSAIgiAExARJ1hfue0MWSca7u4IWA8M598JkRfVCWXPkBeUsUFAPLAvweJKYzj0mM49DLuNhFNu9xmDUYzjusdnpJNhdQiiP5brDYtWBS4+aWHZ9KrT+DaUtQR07e/wJIQ2MbX4ivFnn4ZoU41pUNxIlTbswThHfpLkf9+ewntPkNB4AAAAASUVORK5CYII="},"className":"rounded-lg"}]}]
4b:["$","p",null,{"children":["The ",["$","strong",null,{"children":"Redo"}]," button allows you to ",["$","strong",null,{"children":"reinstate"}]," an action that was previously undone. If you’ve used the Undo button and decide you want to bring back your most recent change, click ",["$","strong",null,{"children":"Redo"}]," to restore it. This gives you flexibility to step forward after undoing an action, ensuring you can adjust your workflow as needed."]}]
