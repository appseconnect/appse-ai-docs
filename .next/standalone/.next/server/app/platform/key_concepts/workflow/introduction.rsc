54:["$","p",null,{"children":["The ",["$","strong",null,{"children":"Fit to Screen"}]," button automatically adjusts the canvas view to ",["$","strong",null,{"children":"fit the entire workflow"}]," within the screen. This allows you to see your whole workflow at once, making it easier to get an overview of the entire process and ensure all nodes and connections are visible."]}]
