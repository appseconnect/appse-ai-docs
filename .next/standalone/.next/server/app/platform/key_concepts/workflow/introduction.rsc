2e:["$","p",null,{"children":["The ",["$","strong",null,{"children":"Get Started"}]," button takes you to a ",["$","strong",null,{"children":"selection screen"}]," where you can choose your ",["$","strong",null,{"children":"trigger node"}],". A trigger node defines ",["$","strong",null,{"children":"how"}]," and ",["$","strong",null,{"children":"when"}]," your workflow should start. You can choose from ",["$","strong",null,{"children":"Trigger Manually"}],", ",["$","strong",null,{"children":"On Schedule"}],", or ",["$","strong",null,{"children":"Webhook"}]," triggers,  or ",["$","strong",null,{"children":"In-app triggers"}],", depending on your workflow needs."]}]
2f:["$","p",null,{"children":"This step is essential to define what starts the workflow, and it gives you the flexibility to choose the most relevant trigger for your use case."}]
