f:["$","$L18",null,{"toc":"$undefined","full":"$undefined","children":[["$","$L19",null,{"children":"Introduction"}],["$","$L1a",null,{"children":"Discover how to save and manage workflows in APPSeAI for future use and modification."}],["$","$L1b",null,{"children":[["$","$L1c",null,{"as":"h1","id":"workflow-designer","children":"Workflow Designer"}],"\n",["$","p",null,{"children":["The ",["$","strong",null,{"children":"Workflow Designer"}]," in appse ai enables you to create, connect, and manage automation workflows visually."]}],"\n",["$","p",null,{"children":["It provides an interactive canvas where you can bring together ",["$","strong",null,{"children":"triggers"}],", ",["$","strong",null,{"children":"application nodes"}],", ",["$","strong",null,{"children":"built-in nodes"}],", and ",["$","strong",null,{"children":"AI agents"}]," to define how data and actions move across your systems."]}],"\n",["$","p",null,{"children":"With the Workflow Designer, you can:"}],"\n",["$","p",null,{"children":[["$","strong",null,{"children":"1. Design workflows from scratch"}]," using a simple drag-and-connect interface.",["$","br",null,{}],"\n",["$","strong",null,{"children":"2. Connect multiple apps and built-in nodes"}]," to automate complex, multi-step processes.",["$","br",null,{}],"\n",["$","strong",null,{"children":"3. Combine different"}]]}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":["$L1d",","]}],"\n",["$","li",null,{"children":"data transformation, and"}],"\n",["$","li",null,{"children":"AI-driven steps into one cohesive workflow."}],"\n"]}],"\n",["$","p",null,{"children":"This visual approach helps teams build and manage integrations effortlessly, without writing a single line of code."}],"\n",["$","$L1c",null,{"as":"h2","id":"exploring-the-workflow-designer","children":"Exploring the Workflow Designer"}],"\n",["$","p",null,{"children":"The Workflow Designer interface is designed to be clean, intuitive, and easy to navigate. Each element on the canvas serves a specific purpose, from managing workflow actions to adjusting your view."}],"\n",["$","p",null,{"children":["Let’s go through what each numbered section in the image represents :\r",["$","$L1e",null,{"sizes":"(max-width: 768px) 100vw, (max-width: 1200px) 70vw, 900px","alt":"workflow designer screen","src":{"src":"/_next/static/media/workflow-designer.0y4_dqlrz.q~5.png","width":3024,"height":1712,"blurWidth":8,"blurHeight":5,"blurDataURL":"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAgAAAAFCAYAAAB4ka1VAAAAUUlEQVR42nWMyw6AIAwE+/8ficpDiokFlfvaaNRgwmEOO9kM+VSQ1gOL1BfW7dMOzxVkOWOcO4QN5LTwCBszHLe7OUzx5qsIyGjGuIIhyCX+nBIolL+52WOjAAAAAElFTkSuQmCC"},"className":"rounded-lg"}]]}],"\n",["$","$L1c",null,{"as":"h3","id":"1-workflow-name","children":"1. Workflow name"}],"\n",["$","p",null,{"children":["$","$L1e",null,{"sizes":"(max-width: 768px) 100vw, (max-width: 1200px) 70vw, 900px","alt":"rename workflow","src":{"src":"/_next/static/media/rename-workflow.0atttdn_vm61k.png","width":572,"height":292,"blurWidth":8,"blurHeight":4,"blurDataURL":"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAgAAAAECAYAAACzzX7wAAAAbElEQVR42h3JwQoCIRhFYd//WaJN0Hu0UVLCGkEXYvpXMBMzdBpdfFwOV4m8CCGQUhqbc6a1hogQY0TVWtFaY63FmCvOOUopg/ceNX9Xlt09bBxOP+S9je7mZUU94pMpVi5GOJ4/3KY6uuvfH58wdrV+hNsXAAAAAElFTkSuQmCC"},"className":"rounded-lg"}]}],"\n",["$","p",null,{"children":["When you create a new workflow, appse ai automatically assigns it a default name, for example, ",["$","strong",null,{"children":"“Workflow 1.”"}],["$","br",null,{}],"\n","The numbering increases each time you create a new one (Workflow 2, Workflow 3, and so on), so you can easily identify them later. You can rename your workflow at any time by simply ",["$","strong",null,{"children":"clicking on the workflow name"}]," at the top of the canvas."]}],"\n",["$","p",null,{"children":["Type a new name that best describes what your workflow does, such as ",["$","em",null,{"children":"“Order Sync – Shopify to SAP”"}]," or ",["$","em",null,{"children":"“Daily Data Backup.”"}]]}],"\n",["$","p",null,{"children":"This helps keep your workspace organized, especially when you’re managing multiple workflows."}],"\n","$L1f","\n","$L20","\n","$L21","\n","$L22","\n","$L23","\n","$L24","\n","$L25","\n","$L26","\n","$L27","\n","$L28","\n","$L29","\n","$L2a","\n","$L2b","\n","$L2c","\n","$L2d","\n","$L2e","\n","$L2f","\n","$L30","\n","$L31","\n","$L32","\n","$L33","\n","$L34","\n","$L35","\n","$L36","\n","$L37","\n","$L38","\n","$L39","\n","$L3a","\n","$L3b","\n","$L3c","\n","$L3d","\n","$L3e","\n","$L3f","\n","$L40","\n","$L41","\n","$L42","\n","$L43","\n","$L44","\n","$L45","\n","$L46","\n","$L47","\n","$L48","\n","$L49","\n","$L4a","\n","$L4b","\n","$L4c","\n","$L4d","\n","$L4e","\n","$L4f","\n","$L50","\n","$L51","\n","$L52","\n","$L53","\n","$L54","\n","$L55","\n","$L56","\n","$L57","\n","$L58"]}]]}]
