26:["$","p",null,{"children":["Notes are used to ",["$","strong",null,{"children":"add text annotations"}]," directly on the workflow canvas.",["$","br",null,{}],"\n","You can use them to write descriptions, instructions, or reminders that help explain parts of your workflow.",["$","br",null,{}],"\n","They don’t affect the workflow’s execution, they’re simply for documentation and better organization."]}]
