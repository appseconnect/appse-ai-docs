1e:["$","p",null,{"children":["When you click the ",["$","strong",null,{"children":"Apps"}]," button, it will open a ",["$","strong",null,{"children":"selection screen"}]," where you can choose from a list of available apps.",["$","br",null,{}],"\n","This allows you to select the app you want to connect to and start creating a workflow based on your chosen app."]}]
1f:["$","p",null,{"children":"It’s the easiest way to integrate and automate tasks between your apps directly within the workflow designer."}]
