12:["$","p",null,{"children":["The ",["$","strong",null,{"children":"Run Once"}]," button lets you ",["$","strong",null,{"children":"manually run the entire workflow"}]," from start to finish, without having to activate or deploy it. This is useful for testing or previewing your workflow in its current state."]}]
13:["$","p",null,{"children":["When you click ‘",["$","strong",null,{"children":"Run Once’"}],", appse ai executes all the nodes in the workflow, just as if it were triggered automatically. However, keep in mind that ",["$","strong",null,{"children":"it will still sync actual data"}]," and could ",["$","strong",null,{"children":"cause changes in the connected applications"}],", so use it with caution."]}]
14:["$","p",null,{"children":"This allows you to test your workflow without fully activating it, providing flexibility to make adjustments before going live."}]
