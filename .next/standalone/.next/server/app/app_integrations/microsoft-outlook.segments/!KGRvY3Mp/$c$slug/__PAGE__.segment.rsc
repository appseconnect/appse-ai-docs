0:{"rsc":["$","$1","c",{"children":[["$","$L2",null,{"children":[["$","$L3",null,{"children":"Microsoft Outlook"}],["$","$L4",null,{"children":"Step-by-step guide to set up Microsoft Outlook credentials for appse.ai integration"}],["$","$L5",null,{"children":[["$","p",null,{"children":[["$","strong",null,{"children":"Microsoft Outlook"}]," is a widely used email and calendar service from Microsoft that helps individuals and organizations manage emails, schedules, and communication efficiently. It is commonly used as part of Microsoft 365 for business and enterprise communication.\r\nThis guide walks you through the process of adding ",["$","strong",null,{"children":"Microsoft Outlook credentials"}]," within Appse AI, enabling integration with secure access to mailboxes and related Outlook features for users."]}],"\n",["$","hr",null,{}],"\n",["$","$L6",null,{"as":"h2","id":"key-features","children":"Key Features"}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Email Integration"}],": Read, send, reply, and manage Outlook emails securely."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Calendar Management"}],": Access and manage calendar events, meetings, and schedules."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Microsoft Graph Support"}],": Uses Microsoft Graph APIs for reliable and secure communication."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Organization-Level Consent"}],": Allows admins to grant permissions once for all users."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Secure OAuth 2.0 Authentication"}],": Ensures token-based authentication without sharing passwords."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Workflow Automation"}],": Integrate Outlook seamlessly with CRMs, ERPs, and other business applications through Appse AI."]}],"\n"]}],"\n",["$","hr",null,{}],"\n",["$","$L6",null,{"