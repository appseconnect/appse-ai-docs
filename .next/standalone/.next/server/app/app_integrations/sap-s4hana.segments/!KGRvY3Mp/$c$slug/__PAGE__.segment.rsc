0:{"rsc":["$","$1","c",{"children":[["$","$L2",null,{"toc":[{"depth":2,"url":"#key-features","title":"Key Features:"},{"depth":2,"url":"#set-credential","title":"Set Credential"},{"depth":2,"url":"#support","title":"Support"}],"children":[["$","$L3",null,{"children":"SAP S4Hana"}],["$","$L4",null,{}],["$","$L5",null,{"children":[["$","p",null,{"children":"SAP S/4HANA is a cloud-based ERP system designed to help businesses manage their core operations, such as finance, procurement, manufacturing, supply chain, and sales on a single integrated platform. It enables organizations to streamline processes, improve efficiency, and make data-driven decisions with real-time insights."}],"\n",["$","$L6",null,{"as":"h2","id":"key-features","children":"Key Features:"}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":"Real-time Data Processing: Leverages SAP S/4HANA’s in-memory computing to deliver instant insights and faster transaction processing."}],"\n",["$","li",null,{"children":"Finance & Accounting Management: Automates financial operations such as reporting, forecasting, and reconciliation with enhanced accuracy."}],"\n",["$","li",null,{"children":"Supply Chain & Inventory Management: Optimizes planning, procurement, production, and logistics with end-to-end visibility."}],"\n",["$","li",null,{"children":"Sales & Order Management: Manages customer orders, pricing, billing, and fulfillment seamlessly across the sales cycle."}],"\n",["$","li",null,{"children":"Manufacturing & Production Planning: Supports complex production workflows with integrated scheduling, resource planning, and shop-floor control."}],"\n",["$","li",null,{"children":"Integrations: Connects smoothly with other SAP modules and external systems for a unified business ecosystem."}],"\n"]}],"\n",["$","$L6",null,{"as":"h2","id":"set-credential","children":"Set Credential"}],"\n",["$","ol",null,{"children":["\n",["$","li",null,{"children":["To get started with SAP S/4HANA, you need to set up your credentials. Click ",["$","strong",null,{"children":"Select a credential"}]," to create a new SAP S/4HANA credential."]}],"\n"]}],"\n",["$","p",null,{"children":["$","$L7",null,{"sizes":"(max-width: 768px) 100vw, (max-width: 1200px) 70vw, 900px","alt":"create a new credential screen","src":{"src":"/_next/static/media/create-a-new-credential.0okp5ro525c0c.png","width":3020,"height":1710,"blurWidth":8,"blurHeight":5,"blurDataURL":"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAgAAAAFCAYAAAB4ka1VAAAAeklEQVR42o3OWw6CMBSEYfa/A6IBNT54X5OJJnIpeEor0kr6e9yBk8zL5HuYLC92XO81lbG0naOqB/qnp2ktxeZEtlwfaXQQHxAXmaaZz5wY34Fye1GgyojHvgJujKSU+CXEqOD8B8jLPbeH0Q9C3VlkUKw1vbBYHfgCdMOQgG0jTpsAAAAASUVORK5CYII="},"className":"rounded-lg"}]}],"\n",["$","ol",null,{"start":"2","children":["\n",["$","li",null,{"children":"This will open a credential configuration pop-up."}],"\n"]}],"\n",["$","p",null,{"children":["$","$L7",null,{"sizes":"(max-width: 768px) 100vw, (max-width: 1200px) 70vw, 900px","alt":"configure credential screen","src":{"src":"/_next/static/media/configure-credential.0964m2d.hl~5t.png","width":1280,"height":1296,"blurWidth":8,"blurHeight":8,"blurDataURL":"data:image/png;base64,"},"className":"rounded-lg"}]}],"\n",["$","ol",null,{"start":"3","children":["\n",["$","li",null,{"children":"To find your Tenant ID, log in to your SAP S/4HANA Cloud account. After logging in, check the URL bar, your Tenant ID appears between https:// and -api.s4hana.cloud.sap."}],"\n"]}],"\n",["$","p",null,{"children":["$","$L7",null,{"sizes":"(max-width: 768px) 100vw, (max-width: 1200px) 70vw, 900px","alt":"tenant id screen","src":{"src":"/_next/static/media/tenant-id.0veh84rqe186z.png","width":1918,"height":1080,"blurWidth":8,"blurHeight":5,"blurDataURL":"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAgAAAAFCAYAAAB4ka1VAAAApElEQVR42hXFOwtBYQCA4e//MTEpNikxKLG6DCi5lFskJGIx4cShSG4likTYxeJ8xx94HcPTI2z+FI5gFqs3juXPE8PsimByhrH5EojZ/o66e6Bs7wzWV0YGdXNhsr2xOtwQuUKRUDSOPVDF7SuzSLY4NTIoyRrzchPR7nSpVOukS