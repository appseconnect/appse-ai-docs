f:["$","$L18",null,{"toc":"$undefined","full":"$undefined","children":[["$","$L19",null,{"children":"QuickBooks"}],["$","$L1a",null,{"children":"Step-by-step guide to set up QuickBooks credentials and automate financial workflows in appse ai."}],["$","$L1b",null,{"children":[["$","p",null,{"children":[["$","strong",null,{"children":"QuickBooks Online"}]," is a cloud accounting platform for small and medium-sized businesses, designed to simplify accounting, invoicing, payroll, and financial reporting. It provides real-time visibility into cash flow, expenses, and profitability — all from a single dashboard. With ",["$","strong",null,{"children":"appse ai"}],", you can connect QuickBooks Online to your existing business tools and automate end-to-end financial workflows."]}],"\n",["$","hr",null,{}],"\n",["$","$L1c",null,{"as":"h2","id":"key-features","children":"Key Features"}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Invoice & Payment Automation"}]," — Automatically create, update, and track invoices and incoming payments without manual intervention."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Customer & Vendor Management"}]," — Sync customer and vendor records across your business tools to keep data consistent and up to date."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Purchase & Sales Order Management"}]," — Trigger workflows when new purchase or sales orders are created, and automate order processing end to end."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Expense & Bill Tracking"}]," — Capture and categorize expenses and bills automatically as they come in."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Real-Time Data Sync"}]," — Keep financial data in sync across your CRM, ERP, and other connected platforms in real time."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Accounts Payable & Receivable"}]," — Automate payment reminders, due date tracking, and reconciliation workflows."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Financial Reporting"}]," — Aggregate and route financial data to reporting tools for up-to-date visibility into business performance."]}],"\n"]}],"\n",["$","hr",null,{}],"\n",["$","$L1c",null,{"as":"h2","id":"setup-credential","children":"Setup Credential"}],"\n",["$","p",null,{"children":"To get started with QuickBooks Online integration, you need to set up credentials."}],"\n",["$","p",null,{"children":["Log in to ",["$","strong",null,{"children":"appse ai"}]," and navigate to ",["$","strong",null,{"children":"Credentials"}]," → ",["$","strong",null,{"children":"Add credentials"}],". Search for ",["$","strong",null,{"children":"QuickBooks"}]," and select it to open the credential form. You can also do this while creating a workflow by clicking ",["$","strong",null,{"children":"Create a new credential"}],".\n",["$","$L1d",null,{"sizes":"(max-width: 768px) 100vw, (max-width: 1200px) 70vw, 900px","alt":"QuickBooks credential form in appse ai","src":{"src":"/_next/static/media/new-credential.0p74dwbfnf2~r.png","width":1912,"height":1000,"blurWidth":8,"blurHeight":4,"blurDataURL":"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAgAAAAECAYAAACzzX7wAAAAfElEQVR42j2MSwqCUABF3aS9wBz3WUaEiQiCUW0qIlGwmWkaLxcgfuAdHyIO7p2cwzFMa8vRCXg8I/KiRP5r4uTN2QsR9h5D2Adc/0r2Kej7AaUU1U/iB3fWms3CjSwvadqOthsWQWx0YaXv5Ia84pRvJadFSYrjXTCtHSPs6GD6+hRP9AAAAABJRU5ErkJggg=="},"className":"rounded-lg"}]]}],"\n","\n",["$","$L1c",null,{"as":"h3","id":"required-fields","children":"Required Fields"}],"\n",["$","div",null,{"className":"relative overflow-auto prose-no-margin my-6","children":["$","table",null,{"children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"children":"Field"}],["$","th",null,{"children":"Description"}]]}]}],["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","td",null,{"children":"Con