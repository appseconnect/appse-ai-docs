14:["$","ul",null,{"children":["\n",["$","li",null,{"children":["\n",["$","p",null,{"children":[["$","strong",null,{"children":"Scrape Website"}]," — Scrape a single URL and retrieve its full content as clean markdown, HTML, or structured data. Ideal for extracting complete information from a specific web page."]}],"\n"]}],"\n",["$","li",null,{"children":["\n",["$","p",null,{"children":[["$","strong",null,{"children":"Crawl Website"}]," — Crawl an entire website starting from a given URL. Firecrawl follows internal links and retrieves content across all accessible sub-pages."]}],"\n"]}],"\n",["$","li",null,{"children":["\n",["$","p",null,{"children":[["$","strong",null,{"children":"Get Crawl Status"}]," — Check the status of an ongoing or completed crawl job. Requires a ",["$","strong",null,{"children":"Crawl Job ID"}]," returned from the Crawl Website action."]}],"\n"]}],"\n",["$","li",null,{"children":["\n",["$","p",null,{"children":[["$","strong",null,{"children":"Extract Website"}]," — Extract specific, structured data from a URL using an AI-powered prompt. Returns only the content you need — such as prices, headlines, or contact details — in clean JSON format."]}],"\n"]}],"\n",["$","li",null,{"children":["\n",["$","p",null,{"children":[["$","strong",null,{"children":"Get Extract Status"}]," — Check the status of an ongoing or completed extract job. Requires an ",["$","strong",null,{"children":"Extract Job ID"}]," returned from the Extract Website action."]}],"\n"]}],"\n",["$","li",null,{"children":["\n",["$","p",null,{"children":[["$","strong",null,{"children":"Search Website"}]," — Search the web and get full page content from the results in a single call. Returns relevant URLs along with their scraped content."]}],"\n"]}],"\n",["$","li",null,{"children":["\n",["$","p",null,{"children":[["$","strong",null,{"children":"Website Map"}]," — Generate a structured map of all URLs found on a website. Useful for discovering the complete link structure of a site before crawling or scraping."]}],"\n"]}],"\n",["$","li",null,{"children":["\n",["$","p",null,{"children":[["$","strong",null,{"children":"Make API Call"}]," — Make a custom API call to any Firecrawl endpoint. Useful for advanced use cases not covered by the standard actions."]}],"\n"]}],"\n"]}]
